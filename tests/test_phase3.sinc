// ==========================================
// tests/test_phase3.sinc
// SAGR Phase 3 Comprehensive Test Suite
// ==========================================

fn test_fl_lzcnt() [
    if (lzcnt64(0) != 64) [
        ret 1;
    ]
    if (lzcnt64(1) != 63) [
        ret 2;
    ]
    if (lzcnt64(2) != 62) [
        ret 3;
    ]
    if (lzcnt64(4) != 61) [
        ret 4;
    ]
    if (lzcnt64(16) != 59) [
        ret 5;
    ]
    if (lzcnt64(256) != 55) [
        ret 6;
    ]
    sh31 = 1 << 31;
    if (lzcnt64(sh31) != 32) [
        ret 7;
    ]
    sh32 = 1 << 32;
    if (lzcnt64(sh32) != 31) [
        ret 8;
    ]
    sh62 = 1 << 62;
    if (lzcnt64(sh62) != 1) [
        ret 9;
    ]
    sh63 = 1 << 63;
    if (lzcnt64(sh63) != 0) [
        ret 10;
    ]
    ret 0;
]

fn test_fl_octagonal_norm() [
    n0 = fl_octagonal_norm(0, 0);
    if (n0 != 0) [
        ret 1;
    ]
    n_h = fl_octagonal_norm(100, 0);
    if (n_h != 100) [
        ret 2;
    ]
    n_v = fl_octagonal_norm(0, 200);
    if (n_v != 200) [
        ret 3;
    ]
    n_diag = fl_octagonal_norm(100, 100);
    if (n_diag != 150) [
        ret 4;
    ]
    n_neg1 = fl_octagonal_norm(-100, 200);
    if (n_neg1 != 250) [
        ret 5;
    ]
    n_neg2 = fl_octagonal_norm(-300, -100);
    if (n_neg2 != 350) [
        ret 6;
    ]
    ret 0;
]

fn test_fl_compute_depth() [
    k0 = fl_compute_depth_k(50);
    if (k0 != 0) [
        ret 1;
    ]
    k1 = fl_compute_depth_k(100);
    if (k1 != 0) [
        ret 2;
    ]
    k2 = fl_compute_depth_k(500);
    if (k2 != 1) [
        ret 3;
    ]
    k3 = fl_compute_depth_k(2000);
    if (k3 != 2) [
        ret 4;
    ]
    k4 = fl_compute_depth_k(8000);
    if (k4 != 3) [
        ret 5;
    ]
    k5 = fl_compute_depth_k(200000);
    if (k5 != 5) [
        ret 6;
    ]
    k_max = fl_compute_depth_k(10000000);
    if (k_max != 7) [
        ret 7;
    ]
    ret 0;
]

fn test_fl_row_mask() [
    m0 = fl_make_row_mask(0, 0);
    if (m0 != 1) [
        ret 1;
    ]
    m5 = fl_make_row_mask(5, 5);
    sh5 = 1 << 5;
    if (m5 != sh5) [
        ret 2;
    ]
    m_span = fl_make_row_mask(2, 4);
    if (m_span != 28) [
        ret 3;
    ]
    all_ones = 0 - 1;
    m_full = fl_make_row_mask(0, 63);
    if (m_full != all_ones) [
        ret 4;
    ]
    m_oob = fl_make_row_mask(64, 70);
    if (m_oob != 0) [
        ret 5;
    ]
    ret 0;
]

fn test_fl_eval_pt() [
    // Linear test: P0=1000, P1=2000, P2=3000 -> delta1=2000, delta2=0
    pt0 = fl_eval_pt(1000, 2000, 0, 0, 2);
    if (pt0 != 1000) [
        ret 1;
    ]
    pt_mid = fl_eval_pt(1000, 2000, 0, 2, 2);
    if (pt_mid != 2000) [
        ret 2;
    ]
    pt_end = fl_eval_pt(1000, 2000, 0, 4, 2);
    if (pt_end != 3000) [
        ret 3;
    ]

    // Quadratic test: P0=0, P1=0, P2=4000 -> delta1=0, delta2=4000
    q_pt0 = fl_eval_pt(0, 0, 4000, 0, 2);
    if (q_pt0 != 0) [
        ret 4;
    ]
    q_pt_mid = fl_eval_pt(0, 0, 4000, 2, 2);
    if (q_pt_mid != 1000) [
        ret 5;
    ]
    q_pt_end = fl_eval_pt(0, 0, 4000, 4, 2);
    if (q_pt_end != 4000) [
        ret 6;
    ]
    ret 0;
]

fn test_fl_flatten_quad_flat!(tape, idx_ptr) [
    idx_ptr@[0] = 0;
    rgba = 4278190335;
    // Nearly straight line: deviation is 0 -> k = 0 -> exactly 1 cord
    fl_flatten_quad!(tape, idx_ptr, 1000, 2000, 2000, 3000, 3000, 4000, rgba);

    if (idx_ptr@[0] != 1) [
        ret 1;
    ]
    w1 = tape@[1];
    w2 = tape@[2];
    x0 = w1 >> 32;
    y0 = w1 & 4294967295;
    x1 = w2 >> 32;
    y1 = w2 & 4294967295;

    if (x0 != 1000) [
        ret 2;
    ]
    if (y0 != 2000) [
        ret 3;
    ]
    if (x1 != 3000) [
        ret 4;
    ]
    if (y1 != 4000) [
        ret 5;
    ]
    ret 0;
]

fn test_fl_flatten_quad_curved!(tape, idx_ptr) [
    idx_ptr@[0] = 0;
    rgba = 65280;
    // Strong curve: P0=(0, 0), P1=(0, 10000), P2=(10000, 10000)
    // Deviation is large, will subdivide into multiple cords
    fl_flatten_quad!(tape, idx_ptr, 0, 0, 0, 10000, 10000, 10000, rgba);

    count = idx_ptr@[0];
    if (count < 2) [
        ret 1;
    ]

    // Verify first cord starts at P0 (0, 0)
    w1_first = tape@[1];
    first_x0 = w1_first >> 32;
    first_y0 = w1_first & 4294967295;
    if (first_x0 != 0) [
        ret 2;
    ]
    if (first_y0 != 0) [
        ret 3;
    ]

    // Verify last cord ends at P2 (10000, 10000)
    last_idx = count - 1;
    last_off = last_idx * 4;
    w2_last = tape@[(last_off + 2)];
    last_x1 = w2_last >> 32;
    last_y1 = w2_last & 4294967295;
    if (last_x1 != 10000) [
        ret 4;
    ]
    if (last_y1 != 10000) [
        ret 5;
    ]

    // Verify C0 continuity: cord j ends where cord j+1 starts
    loop (ci:127 = 0 .. (count - 1)) [
        off_curr = ci * 4;
        off_next = off_curr + 4;
        w2_curr = tape@[(off_curr + 2)];
        w1_next = tape@[(off_next + 1)];
        cx1 = w2_curr >> 32;
        cy1 = w2_curr & 4294967295;
        nx0 = w1_next >> 32;
        ny0 = w1_next & 4294967295;
        if (cx1 != nx0) [
            ret 6;
        ]
        if (cy1 != ny0) [
            ret 7;
        ]
    ]
    ret 0;
]

fn test_fl_flatten_cord_packing!(tape, idx_ptr) [
    idx_ptr@[0] = 0;
    rgba = 4294967040;
    // x in [4096..12288] -> tx in [1..3]
    // y in [8192..16384] -> ty in [2..4]
    fl_emit_cord_raw!(tape, idx_ptr, 4096, 8192, 12288, 16384, rgba);

    if (idx_ptr@[0] != 1) [
        ret 1;
    ]
    w0 = tape@[0];
    w3 = tape@[3];

    op_tag = w0 >> 56;
    if (op_tag != 1) [
        ret 2;
    ]

    rgba_out = w0 & 4294967295;
    if (rgba_out != rgba) [
        ret 3;
    ]

    tx_span = (w0 >> 32) & 65535;
    tx_lo = tx_span >> 8;
    tx_hi = tx_span & 255;
    if (tx_lo != 1) [
        ret 4;
    ]
    if (tx_hi != 3) [
        ret 5;
    ]

    // Rows 2..4 -> bitmask = 28
    if (w3 != 28) [
        ret 6;
    ]
    ret 0;
]

fn test_fl_flatten_tape_mixed!(in_tape, out_tape, idx_ptr) [
    idx_ptr@[0] = 0;
    rgba = 16711680;

    // Cord 0: straight line
    in_tape@[0] = (1 << 56) | rgba;
    in_tape@[1] = (1000 << 32) | 1000;
    in_tape@[2] = (2000 << 32) | 2000;
    in_tape@[3] = 0;

    // Cord 1: quadratic curve
    in_tape@[4] = (2 << 56) | rgba;
    in_tape@[5] = (2000 << 32) | 2000;
    in_tape@[6] = (2000 << 32) | 8000;
    in_tape@[7] = (8000 << 32) | 8000;

    // Cord 2: straight line
    in_tape@[8] = (1 << 56) | rgba;
    in_tape@[9] = (8000 << 32) | 8000;
    in_tape@[10] = (9000 << 32) | 9000;
    in_tape@[11] = 0;

    total_emitted = fl_flatten_tape!(in_tape, 3, out_tape, idx_ptr);

    // 1 line + N quads (at least 2) + 1 line >= 4
    if (total_emitted < 4) [
        ret 1;
    ]
    ret 0;
]

fn test_fl_torture_10k_curves!(scratch_tape, idx_ptr) [
    idx_ptr@[0] = 0;
    rgba = 255;

    // Flatten 10,000 curves without division, sqrt, or crash
    loop (iter:10000 = 0 .. 10000) [
        idx_ptr@[0] = 0;
        x0 = (iter * 17) & 32767;
        y0 = (iter * 31) & 32767;
        x1 = (iter * 53) & 32767;
        y1 = (iter * 79) & 32767;
        x2 = (iter * 97) & 32767;
        y2 = (iter * 113) & 32767;
        fl_flatten_quad!(scratch_tape, idx_ptr, x0, y0, x1, y1, x2, y2, rgba);
        if (idx_ptr@[0] < 1) [
            ret 1;
        ]
    ]
    ret 0;
]

fn main!() [
    sys_mmap!(67108864);
    mmap_base = 536870912;
    arena = arena_init!(mmap_base~, 67108864);
    if (arena == 0) [
        sys_exit!(1);
    ]

    out_tape = arena_alloc_words!(arena, 2048);
    in_tape = arena_alloc_words!(arena, 64);
    idx_ptr = arena_alloc_words!(arena, 2);

    r1 = test_fl_lzcnt();
    if (r1 != 0) [
        sys_exit!(101);
    ]

    r2 = test_fl_octagonal_norm();
    if (r2 != 0) [
        sys_exit!(102);
    ]

    r3 = test_fl_compute_depth();
    if (r3 != 0) [
        sys_exit!(103);
    ]

    r4 = test_fl_row_mask();
    if (r4 != 0) [
        sys_exit!(104);
    ]

    r5 = test_fl_eval_pt();
    if (r5 != 0) [
        sys_exit!(105);
    ]

    r6 = test_fl_flatten_quad_flat!(out_tape, idx_ptr);
    if (r6 != 0) [
        sys_exit!(106);
    ]

    r7 = test_fl_flatten_quad_curved!(out_tape, idx_ptr);
    if (r7 != 0) [
        sys_exit!(107);
    ]

    r8 = test_fl_flatten_cord_packing!(out_tape, idx_ptr);
    if (r8 != 0) [
        sys_exit!(108);
    ]

    r9 = test_fl_flatten_tape_mixed!(in_tape, out_tape, idx_ptr);
    if (r9 != 0) [
        sys_exit!(109);
    ]

    r10 = test_fl_torture_10k_curves!(out_tape, idx_ptr);
    if (r10 != 0) [
        sys_exit!(110);
    ]

    sys_exit!(0);
]
