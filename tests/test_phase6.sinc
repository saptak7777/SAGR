// ==========================================
// tests/test_phase6.sinc
// SAGR Phase 6 Comprehensive Test Suite: MSDF Integer Typography
// ==========================================

fn test_msdf_sfont_header!(header_ptr) [
    msdf_sfont_init!(header_ptr, 512, 512, 16, 4, 96, 1024);

    if (header_ptr@[0] != SFONT_MAGIC) [ ret 1; ]
    w_dims = header_ptr@[1];
    w_w = w_dims >> 16;
    w_h = w_dims & 65535;
    if (w_w != 512) [ ret 2; ]
    if (w_h != 512) [ ret 3; ]

    w_metrics = header_ptr@[2];
    ascent = w_metrics >> 16;
    descent = w_metrics & 65535;
    if (ascent != 16) [ ret 4; ]
    if (descent != 4) [ ret 5; ]

    if (header_ptr@[3] != 96) [ ret 6; ]
    if (header_ptr@[4] != 1024) [ ret 7; ]
    ret 0;
]

fn test_msdf_glyph_quad_packing!(glyphs_base) [
    // Glyph 0: 'A' (unicode 65), advance 12, UV [10, 20, 30, 40], plane [-1, 0, 11, 14]
    msdf_sfont_add_glyph!(glyphs_base, 0, 65, 12, 10, 20, 30, 40, 0 - 1, 0, 11, 14);

    // Glyph 1: 'B' (unicode 66), advance 11, UV [32, 20, 52, 40], plane [0, 0, 10, 14]
    msdf_sfont_add_glyph!(glyphs_base, 1, 66, 11, 32, 20, 52, 40, 0, 0, 10, 14);

    // Verify Glyph 0
    w0 = glyphs_base@[0];
    uni = w0 >> 32;
    adv = w0 & 4294967295;
    if (uni != 65) [ ret 1; ]
    if (adv != 12) [ ret 2; ]

    w1 = glyphs_base@[1];
    u0 = (w1 >> 48) & 65535;
    v0 = (w1 >> 32) & 65535;
    u1 = (w1 >> 16) & 65535;
    v1 = w1 & 65535;
    if (u0 != 10) [ ret 3; ]
    if (v0 != 20) [ ret 4; ]
    if (u1 != 30) [ ret 5; ]
    if (v1 != 40) [ ret 6; ]

    // Find glyphs
    idx_a = msdf_find_glyph(glyphs_base, 2, 65);
    if (idx_a != 0) [ ret 7; ]
    idx_b = msdf_find_glyph(glyphs_base, 2, 66);
    if (idx_b != 1) [ ret 8; ]
    idx_missing = msdf_find_glyph(glyphs_base, 2, 999);
    if (idx_missing != 0 - 1) [ ret 9; ]
    ret 0;
]

fn test_msdf_utf8_ascii!(text_buf) [
    // Store ASCII string "SAGR" (83, 65, 71, 82)
    b0 = 83;
    b1_sh = 65 << 8;
    b2_sh = 71 << 16;
    b3_sh = 82 << 24;
    s01 = b0 | b1_sh;
    s23 = b2_sh | b3_sh;
    text_buf@[0] = s01 | s23;

    dec0 = msdf_decode_utf8(text_buf, 0);
    c0 = dec0 & 4294967295;
    l0 = dec0 >> 32;
    if (c0 != 83) [ ret 1; ]
    if (l0 != 1) [ ret 2; ]

    dec1 = msdf_decode_utf8(text_buf, 1);
    c1 = dec1 & 4294967295;
    l1 = dec1 >> 32;
    if (c1 != 65) [ ret 3; ]
    if (l1 != 1) [ ret 4; ]

    dec2 = msdf_decode_utf8(text_buf, 2);
    c2 = dec2 & 4294967295;
    l2 = dec2 >> 32;
    if (c2 != 71) [ ret 5; ]
    if (l2 != 1) [ ret 6; ]

    dec3 = msdf_decode_utf8(text_buf, 3);
    c3 = dec3 & 4294967295;
    l3 = dec3 >> 32;
    if (c3 != 82) [ ret 7; ]
    if (l3 != 1) [ ret 8; ]
    ret 0;
]

fn test_msdf_utf8_multibyte!(text_buf) [
    // 1. 2-byte UTF-8: Greek Delta (U+0394 = 916) -> 0xCE (206), 0x94 (148)
    b0 = 206;
    b1_sh = 148 << 8;
    text_buf@[0] = b0 | b1_sh;
    dec2 = msdf_decode_utf8(text_buf, 0);
    cp2 = dec2 & 4294967295;
    len2 = dec2 >> 32;
    if (cp2 != 916) [ ret 1; ]
    if (len2 != 2) [ ret 2; ]

    // 2. 3-byte UTF-8: Euro sign (U+20AC = 8364) -> 0xE2 (226), 0x82 (130), 0xAC (172)
    b0_3 = 226;
    b1_3 = 130 << 8;
    b2_3 = 172 << 16;
    s01_3 = b0_3 | b1_3;
    text_buf@[0] = s01_3 | b2_3;
    dec3 = msdf_decode_utf8(text_buf, 0);
    cp3 = dec3 & 4294967295;
    len3 = dec3 >> 32;
    if (cp3 != 8364) [ ret 3; ]
    if (len3 != 3) [ ret 4; ]

    // 3. 4-byte UTF-8: Musical Symbol G Clef (U+1D11E = 119070) -> 0xF0 (240), 0x9D (157), 0x84 (132), 0x9E (158)
    b0_4 = 240;
    b1_4 = 157 << 8;
    b2_4 = 132 << 16;
    b3_4 = 158 << 24;
    s01_4 = b0_4 | b1_4;
    s23_4 = b2_4 | b3_4;
    text_buf@[0] = s01_4 | s23_4;
    dec4 = msdf_decode_utf8(text_buf, 0);
    cp4 = dec4 & 4294967295;
    len4 = dec4 >> 32;
    if (cp4 != 119070) [ ret 5; ]
    if (len4 != 4) [ ret 6; ]
    ret 0;
]

fn test_msdf_median_exhaustive() [
    // Permutation 1: r <= g <= b
    if (msdf_median(50, 100, 150) != 100) [ ret 1; ]
    // Permutation 2: r <= b <= g
    if (msdf_median(50, 150, 100) != 100) [ ret 2; ]
    // Permutation 3: g <= r <= b
    if (msdf_median(100, 50, 150) != 100) [ ret 3; ]
    // Permutation 4: g <= b <= r
    if (msdf_median(150, 50, 100) != 100) [ ret 4; ]
    // Permutation 5: b <= r <= g
    if (msdf_median(100, 150, 50) != 100) [ ret 5; ]
    // Permutation 6: b <= g <= r
    if (msdf_median(150, 100, 50) != 100) [ ret 6; ]

    // Equal values
    if (msdf_median(128, 128, 128) != 128) [ ret 7; ]
    if (msdf_median(0, 0, 0) != 0) [ ret 8; ]
    if (msdf_median(255, 255, 255) != 255) [ ret 9; ]
    ret 0;
]

fn test_msdf_bilinear_exact!(atlas_buf) [
    // Create a 4x4 atlas where texel (1, 1) = 100, (2, 1) = 200, (1, 2) = 100, (2, 2) = 200
    // Fill all texels with 0 first
    loop (ti:16 = 0 .. 16) [
        atlas_buf@[ti] = 0;
    ]

    // Set texels (R, G, B channels all identical for simple check)
    // idx = y * 4 + x
    c100 = 100 | (100 << 8) | (100 << 16);
    c200 = 200 | (200 << 8) | (200 << 16);
    atlas_buf@[5] = c100; // (1, 1)
    atlas_buf@[6] = c200; // (2, 1)
    atlas_buf@[9] = c100; // (1, 2)
    atlas_buf@[10] = c200; // (2, 2)

    // Sample exactly at (1.0, 1.0) -> must be exactly 100
    u_exact = 1 << 16;
    v_exact = 1 << 16;
    res_exact = msdf_bilinear_sample(atlas_buf, 4, u_exact, v_exact);
    r_exact = res_exact & 255;
    if (r_exact != 100) [ ret 1; ]

    // Sample halfway horizontally at (1.5, 1.0) -> (100 + 200)/2 = 150
    u_half = (1 << 16) + (128 << 8);
    res_half = msdf_bilinear_sample(atlas_buf, 4, u_half, v_exact);
    r_half = res_half & 255;
    if (r_half != 150) [ ret 2; ]

    // Sample center at (1.5, 1.5) -> average of all four = (100 + 200 + 100 + 200)/4 = 150
    v_half = (1 << 16) + (128 << 8);
    res_center = msdf_bilinear_sample(atlas_buf, 4, u_half, v_half);
    r_center = res_center & 255;
    if (r_center != 150) [ ret 3; ]
    ret 0;
]

fn test_msdf_screen_space_ramp() [
    scale_1x = 256; // 1.0 in Q8.8

    // 1. Edge center (128) -> exactly 128
    a_edge = msdf_eval_alpha(128, scale_1x);
    if (a_edge != 128) [ ret 1; ]

    // 2. Inside (+30 from edge = 158) -> 128 + 30 = 158
    a_in = msdf_eval_alpha(158, scale_1x);
    if (a_in != 158) [ ret 2; ]

    // 3. Outside (-30 from edge = 98) -> 128 - 30 = 98
    a_out = msdf_eval_alpha(98, scale_1x);
    if (a_out != 98) [ ret 3; ]

    // 4. Far inside (255) with high scale -> saturates cleanly at 255
    scale_high = 512; // 2.0x
    a_sat_hi = msdf_eval_alpha(240, scale_high);
    if (a_sat_hi != 255) [ ret 4; ]

    // 5. Far outside (10) with high scale -> clamps cleanly at 0
    a_sat_lo = msdf_eval_alpha(10, scale_high);
    if (a_sat_lo != 0) [ ret 5; ]
    ret 0;
]

fn test_msdf_sharp_corner_preservation() [
    // In standard SDF, a corner point has a single distance that causes corner rounding.
    // In MSDF, two intersecting edges have distinct color channels:
    // Vertical edge is in Red (d_r = 180 > 128, interior)
    // Horizontal edge is in Blue (d_b = 180 > 128, interior)
    // Diagonal apex has Green = 70 (< 128, exterior)
    // Median of (180, 70, 180) is 180 -> stays sharply inside!
    med_corner = msdf_median(180, 70, 180);
    if (med_corner != 180) [ ret 1; ]

    // Outside the corner: R = 70, G = 180, B = 70
    // Median is 70 -> stays sharply outside!
    med_out = msdf_median(70, 180, 70);
    if (med_out != 70) [ ret 2; ]
    ret 0;
]

fn test_msdf_glyph_tile_shading!(atlas_buf, tile_words) [
    // Create a 16x16 atlas (256 texels) filled with a test glyph distance of 200 (interior)
    val_b = 200 << 16;
    val_g = 200 << 8;
    val_rg = 200 | val_g;
    val = val_rg | val_b;
    ti = 0;
    loop (step:256 = 0 .. 256) [
        atlas_buf@[ti] = val;
        ti = ti + 1;
    ]

    // Clear tile words
    w = 0;
    loop (step_w:128 = 0 .. 128) [
        tile_words@[w] = 0;
        w = w + 1;
    ]

    fg_white = 4294967295; // (255, 255, 255, 255)
    msdf_render_glyph_tile!(atlas_buf, 16, 0, 0, 16, 16, 0, 0, 256, fg_white, tile_words);

    // Verify tile has non-zero words
    w0 = tile_words@[0];
    if (w0 == 0) [ ret 1; ]
    w127 = tile_words@[127];
    if (w127 == 0) [ ret 2; ]

    // Check pixel 0 components
    p0 = w0 & 4294967295;
    a0 = (p0 >> 24) & 255;
    // median 200, cov = 200; fg_a = 255 -> 255 * 200 >> 8 = 199
    if (a0 != 199) [ ret 3; ]
    ret 0;
]

fn test_msdf_layout_line!(glyphs_base, text_buf, positions_buf) [
    // Add ASCII glyphs for 'S' (83), 'A' (65), 'G' (71), 'R' (82)
    msdf_sfont_add_glyph!(glyphs_base, 0, 83, 10, 0, 0, 8, 16, 0, 0, 8, 16);
    msdf_sfont_add_glyph!(glyphs_base, 1, 65, 12, 8, 0, 16, 16, 0, 0, 8, 16);
    msdf_sfont_add_glyph!(glyphs_base, 2, 71, 12, 16, 0, 24, 16, 0, 0, 8, 16);
    msdf_sfont_add_glyph!(glyphs_base, 3, 82, 11, 24, 0, 32, 16, 0, 0, 8, 16);

    // Text: "SAGR" (4 bytes)
    b0 = 83;
    b1_sh = 65 << 8;
    b2_sh = 71 << 16;
    b3_sh = 82 << 24;
    s01 = b0 | b1_sh;
    s23 = b2_sh | b3_sh;
    text_buf@[0] = s01 | s23;

    count = msdf_layout_line!(glyphs_base, 4, text_buf, 4, 100, 200, 256, positions_buf, 100);

    // Must lay out exactly 4 glyphs
    if (count != 4) [ ret 1; ]

    // Glyph 0: 'S', x = 100
    if (positions_buf@[0] != 0) [ ret 2; ]
    if (positions_buf@[1] != 100) [ ret 3; ]

    // Glyph 1: 'A', x = 100 + 10 = 110
    if (positions_buf@[4] != 1) [ ret 4; ]
    if (positions_buf@[5] != 110) [ ret 5; ]

    // Glyph 2: 'G', x = 110 + 12 = 122
    if (positions_buf@[8] != 2) [ ret 6; ]
    if (positions_buf@[9] != 122) [ ret 7; ]

    // Glyph 3: 'R', x = 122 + 12 = 134
    if (positions_buf@[12] != 3) [ ret 8; ]
    if (positions_buf@[13] != 134) [ ret 9; ]
    ret 0;
]

fn test_msdf_4500_glyphs_stress_gate!(glyphs_base, text_buf, positions_buf) [
    // Setup a 90-column line of text repeated 50 times = 4,500 glyphs (full 1080p code editor screen)
    // Fill text_buf with repeating ASCII 65 ('A')
    word_a = 65 | (65 << 8) | (65 << 16) | (65 << 24);
    word_a_hi = word_a << 32;
    word_8a = word_a_hi | (word_a & 4294967295);

    sw = 0;
    loop (step:12 = 0 .. 12) [
        text_buf@[sw] = word_8a;
        sw = sw + 1;
    ]

    total_glyphs = 0;
    line_y = 0;
    loop (line:50 = 0 .. 50) [
        y_pos = line * 20;
        line_count = msdf_layout_line!(glyphs_base, 4, text_buf, 90, 0, y_pos, 256, positions_buf, 100);
        total_glyphs = total_glyphs + line_count;
    ]

    // 50 lines x 90 glyphs = 4,500 glyphs exact
    if (total_glyphs != 4500) [ ret 1; ]
    ret 0;
]

fn test_msdf_background_preservation!(atlas_buf, tile_words) [
    // Pre-fill tile_words with solid background (R:50, G:100, B:150, A:255)
    bg_px = (255 << 24) | (150 << 16) | (100 << 8) | 50;
    bg_w = (bg_px << 32) | bg_px;
    w = 0;
    loop (step:128 = 0 .. 128) [
        tile_words@[w] = bg_w;
        w = w + 1;
    ]

    // Set atlas texels to distance 0 (outside glyph contour, coverage = 0)
    ti = 0;
    loop (step:256 = 0 .. 256) [
        atlas_buf@[ti] = 0;
        ti = ti + 1;
    ]

    // Render glyph (foreground = gold)
    fg_gold = 4278245375;
    msdf_render_glyph_tile!(atlas_buf, 16, 0, 0, 16, 16, 0, 0, 256, fg_gold, tile_words);

    // Pixel 0 must retain original background color (bg_px)
    w0 = tile_words@[0];
    p0 = w0 & 4294967295;
    if (p0 != bg_px) [
        // FAILED: msdf_render_glyph_tile destroyed background with 0!
        ret 1;
    ]
    ret 0;
]

fn main!() [
    sys_mmap!(67108864);
    mmap_base = 536870912;
    arena = arena_init!(mmap_base~, 67108864);
    if (arena == 0) [
        sys_exit!(1);
    ]

    header_buf = arena_alloc_words!(arena, 16);
    glyphs_base = arena_alloc_words!(arena, 512);
    text_buf = arena_alloc_words!(arena, 128);
    atlas_buf = arena_alloc_words!(arena, 1024);
    tile_words = arena_alloc_words!(arena, 128);
    positions_buf = arena_alloc_words!(arena, 1024);

    r1 = test_msdf_sfont_header!(header_buf);
    if (r1 != 0) [ sys_exit!(101); ]

    r2 = test_msdf_glyph_quad_packing!(glyphs_base);
    if (r2 != 0) [ sys_exit!(102); ]

    r3 = test_msdf_utf8_ascii!(text_buf);
    if (r3 != 0) [ sys_exit!(103); ]

    r4 = test_msdf_utf8_multibyte!(text_buf);
    if (r4 != 0) [ sys_exit!(104); ]

    r5 = test_msdf_median_exhaustive();
    if (r5 != 0) [ sys_exit!(105); ]

    r6 = test_msdf_bilinear_exact!(atlas_buf);
    if (r6 != 0) [ sys_exit!(106); ]

    r7 = test_msdf_screen_space_ramp();
    if (r7 != 0) [ sys_exit!(107); ]

    r8 = test_msdf_sharp_corner_preservation();
    if (r8 != 0) [ sys_exit!(108); ]

    r9 = test_msdf_glyph_tile_shading!(atlas_buf, tile_words);
    if (r9 != 0) [ sys_exit!(109); ]

    r10 = test_msdf_layout_line!(glyphs_base, text_buf, positions_buf);
    if (r10 != 0) [ sys_exit!(110); ]

    r11 = test_msdf_4500_glyphs_stress_gate!(glyphs_base, text_buf, positions_buf);
    if (r11 != 0) [ sys_exit!(111); ]

    r12 = test_msdf_background_preservation!(atlas_buf, tile_words);
    if (r12 != 0) [ sys_exit!(112); ]

    sys_exit!(0);
]
