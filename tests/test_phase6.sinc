// ==========================================
// tests/test_phase6.sinc
// SAGR Phase 6 Comprehensive Test Suite: Sovereign TRG & Integer MSDF
// ==========================================

fn test_trg_header_contract!(header_ptr) [
    // 64-Byte TRG Header Contract:
    // Word 0: [Magic:8 (84) | Flags:8 (0) | ScriptB:8 (2) | ScriptA:8 (1) | Length:32 (128)]
    mag_sh = TRG_MAGIC_BYTE << 56;
    flags_sh = 0 << 48;
    b_sh = 2 << 40;
    a_sh = 1 << 32;
    len_lo = 128 & 4294967295;
    w0_hdr = mag_sh | flags_sh;
    w0_scripts = b_sh | a_sh;
    w0_top = w0_hdr | w0_scripts;
    w0 = w0_top | len_lo;
    header_ptr@[0] = w0;

    // Verify byte indexing matches TRG protocol
    magic_b = header_ptr@[7 * 1];
    if (magic_b != TRG_MAGIC_BYTE) [ ret 1; ]

    flags_b = header_ptr@[6 * 1];
    if (flags_b != 0) [ ret 2; ]

    script_b = header_ptr@[5 * 1];
    if (script_b != 2) [ ret 3; ]

    script_a = header_ptr@[4 * 1];
    if (script_a != 1) [ ret 4; ]

    len_val = header_ptr@[0] & 4294967295;
    if (len_val != 128) [ ret 5; ]
    ret 0;
]

fn test_trg_atlas_grid_uv!() [
    // Verify O(1) direct atlas UV derivation for TRG grid cells
    // coord 0 -> (0, 0)
    c0 = 0;
    u0_0 = (c0 & 15) << 4;
    v0_0 = c0 & 65520;
    if (u0_0 != 0) [ ret 1; ]
    if (v0_0 != 0) [ ret 2; ]

    // coord 15 -> (240, 0)
    c15 = 15;
    u0_15 = (c15 & 15) << 4;
    v0_15 = c15 & 65520;
    if (u0_15 != 240) [ ret 3; ]
    if (v0_15 != 0) [ ret 4; ]

    // coord 16 -> (0, 16)
    c16 = 16;
    u0_16 = (c16 & 15) << 4;
    v0_16 = c16 & 65520;
    if (u0_16 != 0) [ ret 5; ]
    if (v0_16 != 16) [ ret 6; ]

    // coord 256 (Page 1) -> (0, 256)
    c256 = 256;
    u0_256 = (c256 & 15) << 4;
    v0_256 = c256 & 65520;
    if (u0_256 != 0) [ ret 7; ]
    if (v0_256 != 256) [ ret 8; ]
    ret 0;
]

fn test_trg_decode_1b_english!() [
    script_a = TRG_SCRIPT_ENGLISH;
    script_b = 0;
    diff_ab = script_b - script_a;
    delta_ab = diff_ab - 128;

    // 1. Slot 0 ('A') -> 256 + 0 = 256
    c0 = trg_decode_1b(0, script_a, delta_ab);
    if (c0 != 256) [ ret 1; ]

    // 2. Slot 25 ('Z') -> 256 + 25 = 281
    c25 = trg_decode_1b(25, script_a, delta_ab);
    if (c25 != 281) [ ret 2; ]

    // 3. Slot 26 ('a') -> 256 + 26 = 282
    c26 = trg_decode_1b(26, script_a, delta_ab);
    if (c26 != 282) [ ret 3; ]

    // 4. Slot 61 ('9') -> 256 + 61 = 317
    c61 = trg_decode_1b(61, script_a, delta_ab);
    if (c61 != 317) [ ret 4; ]

    // 5. Operator Slot 0x70 ('+') -> 112 directly
    c_op = trg_decode_1b(112, script_a, delta_ab);
    if (c_op != 112) [ ret 5; ]

    // 6. Delimiter Slot 0xF0 (' ') -> 240 directly
    c_sp = trg_decode_1b(240, script_a, delta_ab);
    if (c_sp != 240) [ ret 6; ]
    ret 0;
]

fn test_trg_decode_1b_bilingual!() [
    // Bilingual: Bank A = English (256), Bank B = Bengali (512)
    script_a = TRG_SCRIPT_ENGLISH;
    script_b = TRG_SCRIPT_BENGALI;
    diff_ab = script_b - script_a;
    delta_ab = diff_ab - 128;

    // Bank A: Slot 0 ('A') -> 256
    ca = trg_decode_1b(0, script_a, delta_ab);
    if (ca != 256) [ ret 1; ]

    // Bank B: Slot 0 (raw_byte = 128, Bengali slot 0) -> 512 + 0 = 512
    cb0 = trg_decode_1b(128, script_a, delta_ab);
    if (cb0 != 512) [ ret 2; ]

    // Bank B: Slot 16 (raw_byte = 144, Bengali slot 16) -> 512 + 16 = 528
    cb16 = trg_decode_1b(144, script_a, delta_ab);
    if (cb16 != 528) [ ret 3; ]

    // Bilingual: Bank A = English (256), Bank B = Tamil (1024)
    script_b_ta = TRG_SCRIPT_TAMIL;
    diff_ta = script_b_ta - script_a;
    delta_ta = diff_ta - 128;

    // Bank B: Slot 14 (raw_byte = 142, Tamil slot 14) -> 1024 + 14 = 1038
    cta14 = trg_decode_1b(142, script_a, delta_ta);
    if (cta14 != 1038) [ ret 4; ]
    ret 0;
]

fn test_msdf_median_exhaustive() [
    if (msdf_median(50, 100, 150) != 100) [ ret 1; ]
    if (msdf_median(50, 150, 100) != 100) [ ret 2; ]
    if (msdf_median(100, 50, 150) != 100) [ ret 3; ]
    if (msdf_median(150, 50, 100) != 100) [ ret 4; ]
    if (msdf_median(100, 150, 50) != 100) [ ret 5; ]
    if (msdf_median(150, 100, 50) != 100) [ ret 6; ]

    if (msdf_median(128, 128, 128) != 128) [ ret 7; ]
    if (msdf_median(0, 0, 0) != 0) [ ret 8; ]
    if (msdf_median(255, 255, 255) != 255) [ ret 9; ]
    ret 0;
]

fn test_msdf_bilinear_exact!(atlas_buf) [
    // 4x4 atlas buffer
    atlas_buf@[0] = 0;
    atlas_buf@[1] = 255;
    atlas_buf@[4] = 0;
    atlas_buf@[5] = 255;

    // Sample exactly at (0, 0) in Q16.16 -> 0
    res_exact = msdf_bilinear_sample(atlas_buf, 4, 0, 0);
    r_exact = res_exact & 255;
    if (r_exact != 0) [ ret 1; ]

    // Sample at (0.5, 0.0) -> half texel between 0 and 255 -> 127 or 128
    u_half = 32768;
    res_half = msdf_bilinear_sample(atlas_buf, 4, u_half, 0);
    r_half = res_half & 255;
    if (r_half < 127) [ ret 2; ]
    if (r_half > 128) [ ret 3; ]

    // Sample at (0.5, 0.5)
    v_half = 32768;
    res_center = msdf_bilinear_sample(atlas_buf, 4, u_half, v_half);
    r_center = res_center & 255;
    if (r_center < 127) [ ret 4; ]
    if (r_center > 128) [ ret 5; ]
    ret 0;
]

fn test_msdf_screen_space_ramp() [
    scale_1x = 256;
    scale_high = 2048;

    // 1. Exact edge (128) -> alpha = 128
    a_edge = msdf_eval_alpha(128, scale_1x);
    if (a_edge != 128) [ ret 1; ]

    // 2. Inside (+30 from edge = 158) -> 128 + 30 = 158
    a_in = msdf_eval_alpha(158, scale_1x);
    if (a_in != 158) [ ret 2; ]

    // 3. Outside (-30 from edge = 98) -> 128 - 30 = 98
    a_out = msdf_eval_alpha(98, scale_1x);
    if (a_out != 98) [ ret 3; ]

    // 4. Saturating high scale (clamps to 255)
    a_sat_hi = msdf_eval_alpha(240, scale_high);
    if (a_sat_hi != 255) [ ret 4; ]

    // 5. Saturating low scale (clamps to 0)
    a_sat_lo = msdf_eval_alpha(10, scale_high);
    if (a_sat_lo != 0) [ ret 5; ]
    ret 0;
]

fn test_msdf_sharp_corner_preservation() [
    med_corner = msdf_median(180, 70, 180);
    if (med_corner != 180) [ ret 1; ]

    med_out = msdf_median(70, 180, 70);
    if (med_out != 70) [ ret 2; ]
    ret 0;
]

fn test_msdf_glyph_tile_shading!(atlas_buf, tile_words) [
    ti = 0;
    loop (step:256 = 0 .. 256) [
        atlas_buf@[ti] = 13158600; // RGB: (200, 200, 200)
        ti = ti + 1;
    ]

    w = 0;
    loop (step:128 = 0 .. 128) [
        tile_words@[w] = 0;
        w = w + 1;
    ]

    fg_white = 4294967295;
    msdf_render_glyph_tile!(atlas_buf, 16, 0, 0, 16, 16, 0, 0, 256, fg_white, tile_words);

    w0 = tile_words@[0];
    if (w0 == 0) [ ret 1; ]
    w127 = tile_words@[127];
    if (w127 == 0) [ ret 2; ]

    p0 = w0 & 4294967295;
    a0 = (p0 >> 24) & 255;
    if (a0 != 199) [ ret 3; ]
    ret 0;
]

fn test_trg_xor_bracket() [
    // '(' = 0xF4 (244) ^ 1 -> ')' = 0xF5 (245)
    b_lparen = 244;
    b_rparen = b_lparen ^ 1;
    if (b_rparen != 245) [ ret 1; ]

    // '[' = 0xF6 (246) ^ 1 -> ']' = 0xF7 (247)
    b_lbrack = 246;
    b_rbrack = b_lbrack ^ 1;
    if (b_rbrack != 247) [ ret 2; ]

    // '{' = 0xF8 (248) ^ 1 -> '}' = 0xF9 (249)
    b_lbrace = 248;
    b_rbrace = b_lbrace ^ 1;
    if (b_rbrace != 249) [ ret 3; ]

    // Invert back: '}' ^ 1 -> '{'
    b_back = b_rbrace ^ 1;
    if (b_back != 248) [ ret 4; ]
    ret 0;
]

fn test_msdf_layout_trg_line!(out_positions, trg_buf) [
    // Setup TRG container:
    // Header Word 0: [Magic:8 (bits 56..63) | Flags:8 | ScriptB:8 | ScriptA:8 | Length:32]
    // Length = 4, ScriptA = 1 (English), ScriptB = 0, Magic = 84 ('T')
    mag_sh = 84 << 56;
    a_sh = 1 << 32;
    hdr = mag_sh | a_sh;
    w0_hdr = hdr | 4;
    trg_buf@[0] = w0_hdr;

    // Payload (byte 64): TRG string "SAGR"
    // 'S' = slot 18, 'A' = slot 0, 'G' = slot 6, 'R' = slot 17
    payload_ptr = trg_buf + 64;
    payload_ptr@[0 * 1] = 18;
    payload_ptr@[1 * 1] = 0;
    payload_ptr@[2 * 1] = 6;
    payload_ptr@[3 * 1] = 17;

    // Layout line at x=0, y=0, scale=256 (1.0x), max_glyphs=100
    emitted = msdf_layout_trg_line!(trg_buf, 0, 0, 256, out_positions, 100);
    if (emitted != 4) [ ret 1; ]

    // Verify Glyph 0 in out_positions: [coord, x, y, scaled_adv]
    // 'S' in English (Script 1 -> base 256): coord = 256 + 18 = 274
    coord0 = out_positions@[0];
    if (coord0 != 274) [ ret 2; ]
    x0 = out_positions@[1];
    if (x0 != 0) [ ret 3; ]
    y0 = out_positions@[2];
    if (y0 != 0) [ ret 4; ]
    adv0 = out_positions@[3];
    if (adv0 != 4096) [ ret 5; ] // 16 * 256

    // Verify Glyph 1: 'A' -> coord = 256 + 0 = 256, x = 4096
    coord1 = out_positions@[4];
    if (coord1 != 256) [ ret 6; ]
    x1 = out_positions@[5];
    if (x1 != 4096) [ ret 7; ]

    ret 0;
]

fn test_msdf_background_preservation!(atlas_buf, tile_words) [
    bg_px = (255 << 24) | (150 << 16) | (100 << 8) | 50;
    bg_w = (bg_px << 32) | bg_px;
    w = 0;
    loop (step:128 = 0 .. 128) [
        tile_words@[w] = bg_w;
        w = w + 1;
    ]

    ti = 0;
    loop (step:256 = 0 .. 256) [
        atlas_buf@[ti] = 0;
        ti = ti + 1;
    ]

    fg_gold = 4278245375;
    msdf_render_glyph_tile!(atlas_buf, 16, 0, 0, 16, 16, 0, 0, 256, fg_gold, tile_words);

    w0 = tile_words@[0];
    p0 = w0 & 4294967295;
    if (p0 != bg_px) [ ret 1; ]
    ret 0;
]

fn main!() [
    sys_mmap!(67108864);
    mmap_base = 536870912;
    arena = arena_init!(mmap_base~, 67108864);
    if (arena == 0) [
        sys_exit!(1);
    ]

    header_buf = arena_alloc_words!(arena, 16);
    trg_buf = arena_alloc_words!(arena, 128);
    atlas_buf = arena_alloc_words!(arena, 1024);
    tile_words = arena_alloc_words!(arena, 128);
    out_positions = arena_alloc_words!(arena, 512);

    r1 = test_trg_header_contract!(header_buf);
    if (r1 != 0) [ sys_exit!(101); ]

    r2 = test_trg_atlas_grid_uv!();
    if (r2 != 0) [ sys_exit!(102); ]

    r3 = test_trg_decode_1b_english!();
    if (r3 != 0) [ sys_exit!(103); ]

    r4 = test_trg_decode_1b_bilingual!();
    if (r4 != 0) [ sys_exit!(104); ]

    r5 = test_msdf_median_exhaustive();
    if (r5 != 0) [ sys_exit!(105); ]

    r6 = test_msdf_bilinear_exact!(atlas_buf);
    if (r6 != 0) [ sys_exit!(106); ]

    r7 = test_msdf_screen_space_ramp();
    if (r7 != 0) [ sys_exit!(107); ]

    r8 = test_msdf_sharp_corner_preservation();
    if (r8 != 0) [ sys_exit!(108); ]

    r9 = test_msdf_glyph_tile_shading!(atlas_buf, tile_words);
    if (r9 != 0) [ sys_exit!(109); ]

    r10 = test_trg_xor_bracket();
    if (r10 != 0) [ sys_exit!(110); ]

    r11 = test_msdf_layout_trg_line!(out_positions, trg_buf);
    if (r11 != 0) [ sys_exit!(111); ]

    r12 = test_msdf_background_preservation!(atlas_buf, tile_words);
    if (r12 != 0) [ sys_exit!(112); ]

    sys_exit!(0);
]
