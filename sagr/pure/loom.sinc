// ==========================================
// sagr/pure/loom.sinc
// The Jacquard Loom Core: Unsorted Warp Pluck & 4-Cycle Weft Shuttle
// ==========================================

fn lm_abs(v) [
    if (v < 0) [
        ret 0 - v;
    ]
    ret v;
]

fn lm_clamp(val, lo, hi) [
    if (val < lo) [
        ret lo;
    ]
    if (val > hi) [
        ret hi;
    ]
    ret val;
]

fn lm_min(a, b) [
    if (a < b) [
        ret a;
    ]
    ret b;
]

fn lm_max(a, b) [
    if (a > b) [
        ret a;
    ]
    ret b;
]

fn lm_resolve_nonzero(w) [
    if (w < 0) [
        w = 0 - w;
    ]
    if (w > 256) [
        ret 256;
    ]
    ret w;
]

fn lm_resolve_evenodd(w) [
    if (w < 0) [
        w = 0 - w;
    ]
    m = w & 511;
    if (m > 256) [
        fold = 512 - m;
        ret fold;
    ]
    ret m;
]

fn lm_weft_row!(warp_scratch, row) [
    base = row * 16;
    // Step 1: Shift +1 (col = 15 down to 1)
    loop (k1:15 = 0 .. 15) [
        col1 = 15 - k1;
        prev1 = col1 - 1;
        i_curr1 = base + col1;
        i_prev1 = base + prev1;
        c1 = warp_scratch@[i_curr1];
        p1 = warp_scratch@[i_prev1];
        warp_scratch@[i_curr1] = c1 + p1;
    ]
    // Step 2: Shift +2 (col = 15 down to 2)
    loop (k2:14 = 0 .. 14) [
        col2 = 15 - k2;
        prev2 = col2 - 2;
        i_curr2 = base + col2;
        i_prev2 = base + prev2;
        c2 = warp_scratch@[i_curr2];
        p2 = warp_scratch@[i_prev2];
        warp_scratch@[i_curr2] = c2 + p2;
    ]
    // Step 3: Shift +4 (col = 15 down to 4)
    loop (k3:12 = 0 .. 12) [
        col3 = 15 - k3;
        prev3 = col3 - 4;
        i_curr3 = base + col3;
        i_prev3 = base + prev3;
        c3 = warp_scratch@[i_curr3];
        p3 = warp_scratch@[i_prev3];
        warp_scratch@[i_curr3] = c3 + p3;
    ]
    // Step 4: Shift +8 (col = 15 down to 8)
    loop (k4:8 = 0 .. 8) [
        col4 = 15 - k4;
        prev4 = col4 - 8;
        i_curr4 = base + col4;
        i_prev4 = base + prev4;
        c4 = warp_scratch@[i_curr4];
        p4 = warp_scratch@[i_prev4];
        warp_scratch@[i_curr4] = c4 + p4;
    ]
    ret 0;
]

fn lm_slice_cord_row!(warp_ptr, tile_x, tile_y, row, x0, y0, x1, y1) [
    x_tile = tile_x << 12;
    y_tile = tile_y << 12;
    row_sh = row << 8;
    y_top = y_tile + row_sh;
    y_bot = y_top + 256;
    ya = lm_clamp(y0, y_top, y_bot);
    yb = lm_clamp(y1, y_top, y_bot);
    delta_y = yb - ya;
    if (delta_y == 0) [
        ret 0;
    ]
    dy = y1 - y0;
    dx = x1 - x0;
    rem_a = ya - y0;
    num_a = rem_a * dx;
    step_a = num_a / dy;
    xa = x0 + step_a;
    la = xa - x_tile;
    rem_b = yb - y0;
    num_b = rem_b * dx;
    step_b = num_b / dy;
    xb = x0 + step_b;
    lb = xb - x_tile;
    // Right-boundary vertical cord writes directly to row carry slot (256 + row)
    if ((la == 4096) & (lb == 4096)) [
        term_idx = 256 + row;
        warp_ptr@[term_idx] = warp_ptr@[term_idx] + delta_y;
        ret 0;
    ]
    x_lo = lm_min(la, lb);
    x_hi = lm_max(la, lb);
    same_x = x_lo == x_hi;
    x_hi = x_hi + same_x;
    tx0 = lm_clamp(x_lo, 0, 4096);
    tx1 = lm_clamp(x_hi, 0, 4096);
    if (tx0 == tx1) [
        ret 0;
    ]
    span_x = x_hi - x_lo;
    d_start = tx0 - x_lo;
    n_start = d_start * delta_y;
    prev_i = n_start / span_x;
    col_lo = tx0 >> 8;
    tx1_m1 = tx1 - 1;
    col_hi = tx1_m1 >> 8;
    col_end = col_hi + 1;
    row_base = row * 16;
    prev_x = tx0;
    loop (c:16 = col_lo .. col_end) [
        c_nxt = c + 1;
        cx1 = c_nxt << 8;
        xs1 = lm_min(cx1, tx1);
        dx_c = xs1 - x_lo;
        num_i = dx_c * delta_y;
        cur_i = num_i / span_x;
        dy_col = cur_i - prev_i;
        x_sum = prev_x + xs1;
        x_mid = x_sum >> 1;
        x_sub = x_mid & 255;
        prod_a1 = dy_col * x_sub;
        da1 = prod_a1 >> 8;
        da0 = dy_col - da1;
        idx0 = row_base + c;
        warp_ptr@[idx0] = warp_ptr@[idx0] + da0;
        idx1 = idx0 + 1;
        // Column 15 right-side AA spill writes to row carry slot (256 + row)
        if (c == 15) [
            idx1 = 256 + row;
        ]
        warp_ptr@[idx1] = warp_ptr@[idx1] + da1;
        prev_i = cur_i;
        prev_x = xs1;
    ]
    ret 0;
]

fn lm_pluck_cord!(warp_ptr, tile_x, tile_y, x0, y0, x1, y1) [
    if (y0 == y1) [
        ret 0;
    ]
    loop (r:TILE_DIM = 0 .. TILE_DIM) [
        lm_slice_cord_row!(warp_ptr, tile_x, tile_y, r, x0, y0, x1, y1);
    ]
    ret 0;
]

fn lm_weave_tile_backdrop!(tape, tape_len, tile_x, tile_y, winding_rule, in_backdrop, out_backdrop, warp_scratch, out_coverage) [
    loop (zi:LOOM_WARP_SCRATCH_WORDS = 0 .. LOOM_WARP_SCRATCH_WORDS) [
        warp_scratch@[zi] = 0;
    ]

    if (in_backdrop != 0) [
        loop (br:TILE_DIM = 0 .. TILE_DIM) [
            bd_val = in_backdrop@[br];
            r_base = br * 16;
            warp_scratch@[r_base] = bd_val;
        ]
    ]

    loop (ci:10000 = 0 .. tape_len) [
        off = ci * 4;
        w0 = tape@[off];
        w1_idx = off + 1;
        w1 = tape@[w1_idx];
        w2_idx = off + 2;
        w2 = tape@[w2_idx];
        w3_idx = off + 3;
        w3 = tape@[w3_idx];

        op = w0 >> 56;
        if (op == 1) [
            w3_sh = w3 >> tile_y;
            has_y = w3_sh & 1;
            if (has_y == 1) [
                w0_sh = w0 >> 32;
                tx_span = w0_sh & 65535;
                tx_lo = tx_span >> 8;
                tx_hi = tx_span & 255;
                in_x = 1;
                if (tile_x < tx_lo) [
                    in_x = 0;
                ]
                if (tile_x > tx_hi) [
                    in_x = 0;
                ]
                if (in_x == 1) [
                    x0 = w1 >> 32;
                    y0 = w1 & 4294967295;
                    x1 = w2 >> 32;
                    y1 = w2 & 4294967295;
                    lm_pluck_cord!(warp_scratch, tile_x, tile_y, x0, y0, x1, y1);
                ]
            ]
        ]
    ]

    loop (r:TILE_DIM = 0 .. TILE_DIM) [
        lm_weft_row!(warp_scratch, r);
        row_off = r * 16;
        if (out_backdrop != 0) [
            last_idx = row_off + 15;
            term_idx = 256 + r;
            w_last = warp_scratch@[last_idx];
            w_term = warp_scratch@[term_idx];
            out_bd_val = w_last + w_term;
            out_backdrop@[r] = out_bd_val;
        ]
        loop (c:TILE_DIM = 0 .. TILE_DIM) [
            idx = row_off + c;
            raw_weft = warp_scratch@[idx];
            cov = 0;
            if (winding_rule == 0) [
                cov = lm_resolve_nonzero(raw_weft);
            ]
            if (winding_rule == 1) [
                cov = lm_resolve_evenodd(raw_weft);
            ]
            out_coverage@[idx] = cov;
        ]
    ]
    ret 0;
]

fn lm_weave_tile!(tape, tape_len, tile_x, tile_y, winding_rule, warp_scratch, out_coverage) [
    ret lm_weave_tile_backdrop!(tape, tape_len, tile_x, tile_y, winding_rule, 0, 0, warp_scratch, out_coverage);
]

fn lm_weave_tile_row!(tape, tape_len, ty, nx, winding_rule, warp_scratch, tile_coverage, backdrop_buf) [
    loop (r:TILE_DIM = 0 .. TILE_DIM) [
        backdrop_buf@[r] = 0;
    ]
    loop (tx:SLSP_TILES_X = 0 .. nx) [
        lm_weave_tile_backdrop!(tape, tape_len, tx, ty, winding_rule, backdrop_buf, backdrop_buf, warp_scratch, tile_coverage);
    ]
    ret 0;
]

fn lm_shade_pixel(bg_r, bg_g, bg_b, bg_a, diff_r, diff_g, diff_b, diff_a, alpha) [
    pdr = diff_r * alpha;
    dr = pdr >> 8;
    r = bg_r + dr;
    pdg = diff_g * alpha;
    dg = pdg >> 8;
    g = bg_g + dg;
    pdb = diff_b * alpha;
    db = pdb >> 8;
    b = bg_b + db;
    pda = diff_a * alpha;
    da = pda >> 8;
    a = bg_a + da;
    g_sh = g << 8;
    b_sh = b << 16;
    a_sh = a << 24;
    rg = r | g_sh;
    ba = b_sh | a_sh;
    rgba = rg | ba;
    ret rgba;
]

fn lm_shade_tile_rgba!(coverage, fg_rgba, bg_rgba, tile_words) [
    fg_r = fg_rgba & 255;
    fg_g_sh = fg_rgba >> 8;
    fg_g = fg_g_sh & 255;
    fg_b_sh = fg_rgba >> 16;
    fg_b = fg_b_sh & 255;
    fg_a_sh = fg_rgba >> 24;
    fg_a = fg_a_sh & 255;

    bg_r = bg_rgba & 255;
    bg_g_sh = bg_rgba >> 8;
    bg_g = bg_g_sh & 255;
    bg_b_sh = bg_rgba >> 16;
    bg_b = bg_b_sh & 255;
    bg_a_sh = bg_rgba >> 24;
    bg_a = bg_a_sh & 255;

    diff_r = fg_r - bg_r;
    diff_g = fg_g - bg_g;
    diff_b = fg_b - bg_b;
    diff_a = fg_a - bg_a;

    loop (r:TILE_DIM = 0 .. TILE_DIM) [
        row_cov = r * 16;
        row_word = r * 8;
        loop (p:TILE_SCANLINE_WORDS = 0 .. TILE_SCANLINE_WORDS) [
            c0 = p * 2;
            c1 = c0 + 1;
            i0 = row_cov + c0;
            i1 = row_cov + c1;
            alpha0 = coverage@[i0];
            alpha1 = coverage@[i1];
            rgba0 = lm_shade_pixel(bg_r, bg_g, bg_b, bg_a, diff_r, diff_g, diff_b, diff_a, alpha0);
            rgba1 = lm_shade_pixel(bg_r, bg_g, bg_b, bg_a, diff_r, diff_g, diff_b, diff_a, alpha1);
            w_hi = rgba1 << 32;
            w_lo = rgba0 & 4294967295;
            word_val = w_hi | w_lo;
            w_idx = row_word + p;
            tile_words@[w_idx] = word_val;
        ]
    ]
    ret 0;
]
