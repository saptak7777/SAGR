// ==========================================
// sagr/pure/msdf.sinc
// Sovereign TRG Ingestion, Branchless Integer MSDF & Typography Engine
// ==========================================

fn trg_decode_1b(raw_byte~, script_a, delta_ab) [
    b_hi = raw_byte >> 7;
    plane_mask = 0 - b_hi;
    masked_delta = delta_ab & plane_mask;
    lang_base = script_a + masked_delta;
    ap_low = raw_byte & TRG_MASK_APERTURE;
    ap_carry = ap_low + TRG_CARRY_ADD;
    carry_bit = ap_carry >> 7;
    is_lang = carry_bit - 1;
    lang_offset = lang_base & is_lang;
    coord = raw_byte + lang_offset;
    ret coord;
]

fn msdf_median(r, g, b) [
    min_rg = lm_min(r, g);
    max_rg = lm_max(r, g);
    min_max_b = lm_min(b, max_rg);
    med = lm_max(min_rg, min_max_b);
    ret med;
]

fn msdf_sample_texel(atlas_ptr, atlas_w, tx, ty) [
    idx = ty * atlas_w;
    full_idx = idx + tx;
    texel = atlas_ptr@[full_idx];
    ret texel;
]

fn msdf_bilinear_sample(atlas_ptr, atlas_w, u_q16, v_q16) [
    u0 = u_q16 >> 16;
    v0 = v_q16 >> 16;
    u1 = u0 + 1;
    v1 = v0 + 1;

    u_sh8 = u_q16 >> 8;
    fu = u_sh8 & 255;
    v_sh8 = v_q16 >> 8;
    fv = v_sh8 & 255;

    inv_u = 256 - fu;
    inv_v = 256 - fv;

    w00_prod = inv_u * inv_v;
    w00 = w00_prod >> 8;

    w10_prod = fu * inv_v;
    w10 = w10_prod >> 8;

    w01_prod = inv_u * fv;
    w01 = w01_prod >> 8;

    w11_prod = fu * fv;
    w11 = w11_prod >> 8;

    t00 = msdf_sample_texel(atlas_ptr, atlas_w, u0, v0);
    t10 = msdf_sample_texel(atlas_ptr, atlas_w, u1, v0);
    t01 = msdf_sample_texel(atlas_ptr, atlas_w, u0, v1);
    t11 = msdf_sample_texel(atlas_ptr, atlas_w, u1, v1);

    r00 = t00 & 255;
    r10 = t10 & 255;
    r01 = t01 & 255;
    r11 = t11 & 255;

    r00_t = r00 * w00;
    r10_t = r10 * w10;
    r01_t = r01 * w01;
    r11_t = r11 * w11;

    r_sum1 = r00_t + r10_t;
    r_sum2 = r01_t + r11_t;
    r_tot = r_sum1 + r_sum2;
    r_out = r_tot >> 8;

    t00_g = t00 >> 8;
    g00 = t00_g & 255;
    t10_g = t10 >> 8;
    g10 = t10_g & 255;
    t01_g = t01 >> 8;
    g01 = t01_g & 255;
    t11_g = t11 >> 8;
    g11 = t11_g & 255;

    g00_t = g00 * w00;
    g10_t = g10 * w10;
    g01_t = g01 * w01;
    g11_t = g11 * w11;

    g_sum1 = g00_t + g10_t;
    g_sum2 = g01_t + g11_t;
    g_tot = g_sum1 + g_sum2;
    g_out = g_tot >> 8;

    t00_b = t00 >> 16;
    b00 = t00_b & 255;
    t10_b = t10 >> 16;
    b10 = t10_b & 255;
    t01_b = t01 >> 16;
    b01 = t01_b & 255;
    t11_b = t11 >> 16;
    b11 = t11_b & 255;

    b00_t = b00 * w00;
    b10_t = b10 * w10;
    b01_t = b01 * w01;
    b11_t = b11 * w11;

    b_sum1 = b00_t + b10_t;
    b_sum2 = b01_t + b11_t;
    b_tot = b_sum1 + b_sum2;
    b_out = b_tot >> 8;

    sh_g = g_out << 8;
    sh_b = b_out << 16;
    rg = r_out | sh_g;
    res = rg | sh_b;
    ret res;
]

fn msdf_eval_alpha(med_dist, screen_scale_q8) [
    delta_d = med_dist - 128;
    prod = delta_d * screen_scale_q8;
    sh_prod = prod >> 8;
    raw_alpha = 128 + sh_prod;
    c_max = lm_min(raw_alpha, 255);
    alpha = lm_max(c_max, 0);
    ret alpha;
]

fn msdf_eval_pixel(atlas_ptr, atlas_w, glyph_u0, glyph_v0, c, r, screen_scale_q8, fg_a, fg_r, fg_g, fg_b) [
    gu_sh = glyph_u0 << 16;
    c_sh = c << 16;
    u_px = gu_sh + c_sh;
    gv_sh = glyph_v0 << 16;
    r_sh = r << 16;
    v_px = gv_sh + r_sh;
    rgb = msdf_bilinear_sample(atlas_ptr, atlas_w, u_px, v_px);
    r_val = rgb & 255;
    rgb_g = rgb >> 8;
    g_val = rgb_g & 255;
    rgb_b = rgb >> 16;
    b_val = rgb_b & 255;
    med = msdf_median(r_val, g_val, b_val);
    cov = msdf_eval_alpha(med, screen_scale_q8);

    pa = fg_a * cov;
    a = pa >> 8;
    pr = fg_r * cov;
    cr = pr >> 8;
    pg = fg_g * cov;
    cg = pg >> 8;
    pb = fg_b * cov;
    cb = pb >> 8;
    cg_sh = cg << 8;
    cb_sh = cb << 16;
    a_sh = a << 24;
    rg = cr | cg_sh;
    ba = cb_sh | a_sh;
    p = rg | ba;
    ret p;
]

fn msdf_render_glyph_tile!(atlas_ptr, atlas_w, glyph_u0, glyph_v0, glyph_w, glyph_h, tile_tx, tile_ty, screen_scale_q8, fg_rgba, tile_words) [
    fg_r = fg_rgba & 255;
    fg_g_sh = fg_rgba >> 8;
    fg_g = fg_g_sh & 255;
    fg_b_sh = fg_rgba >> 16;
    fg_b = fg_b_sh & 255;
    fg_a_sh = fg_rgba >> 24;
    fg_a = fg_a_sh & 255;

    loop (r:TILE_DIM = 0 .. TILE_DIM) [
        row_w = r * 8;
        loop (p:TILE_SCANLINE_WORDS = 0 .. TILE_SCANLINE_WORDS) [
            c0 = p * 2;
            c1 = c0 + 1;
            src_p0 = msdf_eval_pixel(atlas_ptr, atlas_w, glyph_u0, glyph_v0, c0, r, screen_scale_q8, fg_a, fg_r, fg_g, fg_b);
            src_p1 = msdf_eval_pixel(atlas_ptr, atlas_w, glyph_u0, glyph_v0, c1, r, screen_scale_q8, fg_a, fg_r, fg_g, fg_b);

            w_idx = row_w + p;
            dst_word = tile_words@[w_idx];
            dst_p0 = dst_word & 4294967295;
            dst_p1_sh = dst_word >> 32;
            dst_p1 = dst_p1_sh & 4294967295;

            out_p0 = hd_blend_pixel(src_p0, dst_p0);
            out_p1 = hd_blend_pixel(src_p1, dst_p1);

            hi_w = out_p1 << 32;
            lo_w = out_p0 & 4294967295;
            tile_words@[w_idx] = hi_w | lo_w;
        ]
    ]
    ret 0;
]

fn msdf_layout_trg_line!(trg_buf, start_x_q8, start_y_q8, scale_q8, out_positions, max_glyphs) [
    magic = trg_buf@[7 * 1];
    if (magic != TRG_MAGIC_BYTE) [
        ret 0;
    ]
    raw_len = trg_buf@[0];
    length = raw_len & 4294967295;
    run_len = lm_min(length, max_glyphs);

    sa_raw = trg_buf@[4 * 1];
    script_a = sa_raw << 8;
    sb_raw = trg_buf@[5 * 1];
    script_b = sb_raw << 8;
    diff_ab = script_b - script_a;
    delta_ab = diff_ab - 128;

    scaled_adv = 16 * scale_q8;
    payload = trg_buf + TRG_PAYLOAD_OFFSET;
    cur_x = start_x_q8;

    loop (i:4096 = 0 .. run_len) [
        raw_b = payload@[i * 1];
        coord = trg_decode_1b(raw_b, script_a, delta_ab);
        off = i * 4;
        out_positions@[off] = coord;
        off1 = off + 1;
        out_positions@[off1] = cur_x;
        off2 = off + 2;
        out_positions@[off2] = start_y_q8;
        off3 = off + 3;
        out_positions@[off3] = scaled_adv;
        cur_x = cur_x + scaled_adv;
    ]
    ret run_len;
]
