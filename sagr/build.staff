// ==========================================
// sagr/build.staff
// SAGR: Simple Analytical Grid Renderer
// Master Project Manifest
// ==========================================

artifact sagr [
    target = linux_x64;
    type   = bin;
]

deps [
    steel/sys/sys.sinc;
    steel/sys/arena.sinc;
    steel/pure/bitset.sinc;
]

flags [
    optimize = 3;
    heap     = 1000000000;
]
