// ==========================================
// sagr/build.staff
// SAGR: Simple Analytical Grid Renderer
// Master Project Manifest
// ==========================================

artifact sagr [
    target = linux_x64;
    type   = bin;
]

deps [
    steel/sys/sys.sinc;
    steel/sys/arena.sinc;
]

driver [
    steel/sys/driver_sagr_linux.sinc;
]

flags [
    optimize = 3;
    heap     = 67108864;
]
