// ==========================================
// sagr/sys/entry.sinc
// Sovereign In-Memory Jacquard Loom Core (SPINE ABI)
// ==========================================

fn sagr_core!(tape_buf, tape_bytes, surf_ptr, arena) [
    if (tape_buf == 0) [
        ret 1;
    ]
    if (surf_ptr == 0) [
        ret 2;
    ]
    if (arena == 0) [
        ret 3;
    ]
    if (tape_bytes < 64) [
        ret 4;
    ]
    w0_hdr = tape_buf@[0];
    magic = w0_hdr >> 32;
    if (magic != BAKE_STAPE_MAGIC) [
        ret 5;
    ]
    cord_cnt = w0_hdr & 4294967295;
    if (cord_cnt == 0) [
        ret 0;
    ]
    cords_ptr = tape_buf + 64;
    fb_ptr = surf_ptr.SLSP_WORD_FB_PTR;
    mask_ptr = surf_ptr.SLSP_WORD_MASK_PTR;
    w0_surf = surf_ptr.SLSP_WORD_DIMS;
    surf_w = w0_surf & 4294967295;
    surf_h = w0_surf >> 32;
    tw_cnt = surf_w >> 4;
    th_cnt = surf_h >> 4;
    min_t = lm_min(tw_cnt, th_cnt);
    if (min_t == 0) [
        ret 2;
    ]
    max_tx = tw_cnt - 1;
    if (th_cnt > 64) [
        th_cnt = 64;
    ]
    w1_surf = surf_ptr.SLSP_WORD_STRIDE_FMT;
    stride = w1_surf & 4294967295;

    cov_scratch = arena_alloc_words!(arena, LOOM_COV_SCRATCH_WORDS);
    warp_scratch = arena_alloc_words!(arena, LOOM_WARP_SCRATCH_WORDS);
    tile_words = arena_alloc_words!(arena, TILE_WORDS);
    src_tile = arena_alloc_words!(arena, TILE_WORDS);
    backdrop_buf = arena_alloc_words!(arena, TILE_DIM);
    if (backdrop_buf == 0) [
        ret 3;
    ]

    hd_reap_shutter!(cords_ptr, cord_cnt, mask_ptr);
    slsp_clear_dirty!(mask_ptr);

    c_idx = 0;
    loop (grp_step:10000 = 0 .. cord_cnt) [
        if (c_idx < cord_cnt) [
            c_off = c_idx << 2;
            cw0 = cords_ptr@[c_off];
            cop = cw0 >> 56;
            if (cop == 0) [
                c_idx = c_idx + 1;
            ]
            if (cop != 0) [
                rgba = cw0 & 4294967295;
                fg_a = rgba >> 24;
                grp_start = c_idx;
                grp_cnt = 0;
                tx_min = tw_cnt;
                tx_max = 0;
                row_mask = 0;
                scanning = 1;
                rem = cord_cnt - grp_start;
                loop (scan_off:10000 = 0 .. rem) [
                    if (scanning == 1) [
                        s_idx = grp_start + scan_off;
                        s_off = s_idx << 2;
                        sw0 = cords_ptr@[s_off];
                        sop = sw0 >> 56;
                        srgba = sw0 & 4294967295;
                        if (sop == 0) [
                            scanning = 0;
                        ]
                        if (srgba != rgba) [
                            scanning = 0;
                        ]
                        if (scanning == 1) [
                            sw0_s1 = sw0 >> 40;
                            tx_lo = sw0_s1 & 255;
                            sw0_s2 = sw0 >> 32;
                            tx_hi = sw0_s2 & 255;
                            tx_min = lm_min(tx_min, tx_lo);
                            tx_max = lm_max(tx_max, tx_hi);
                            sw3_off = s_off + 3;
                            sw3 = cords_ptr@[sw3_off];
                            row_mask = row_mask | sw3;
                            grp_cnt = grp_cnt + 1;
                        ]
                    ]
                ]
                has_span = row_mask != 0;
                if (tx_min > max_tx) [
                    has_span = 0;
                ]
                if (has_span == 1) [
                    tx_max = lm_min(tx_max, max_tx);
                    grp_byte_off = grp_start << 5;
                    grp_ptr = cords_ptr + grp_byte_off;
                    tx_end = tx_max + 1;
                    loop (ty:64 = 0 .. th_cnt) [
                        r_shift = row_mask >> ty;
                        r_bit = r_shift & 1;
                        if (r_bit == 1) [
                            hd_backdrop_init!(backdrop_buf);
                            loop (tx:SLSP_TILES_X = tx_min .. tx_end) [
                                wv = lm_weave_tile_backdrop!(grp_ptr, grp_cnt, tx, ty, 0, backdrop_buf, backdrop_buf, warp_scratch, cov_scratch);
                                cov_or = wv & 4294967295;
                                if (cov_or != 0) [
                                    all_full = wv >> 32;
                                    is_opaque = fg_a == 255;
                                    is_solid = all_full & is_opaque;
                                    if (is_solid == 1) [
                                        hd_broadcast_solid!(tile_words, rgba);
                                    ]
                                    if (is_solid == 0) [
                                        slsp_read_tile!(fb_ptr, tx, ty, stride, tile_words);
                                        lm_shade_tile_rgba!(cov_scratch, rgba, 0, src_tile);
                                        hd_composite_source_over!(tile_words, src_tile);
                                    ]
                                    slsp_beam_flush_tile!(fb_ptr, tx, ty, stride, tile_words~);
                                    slsp_stamp_tile!(mask_ptr, tx, ty);
                                ]
                            ]
                        ]
                    ]
                ]
                c_idx = grp_start + grp_cnt;
            ]
        ]
    ]
    ret 0;
]
