// ==========================================
// sassets/pure/bake_lexer.sinc
// SAGR Sovereign Asset Compiler Shared Lexer (TRG-Native + PPM Header Ints)
// Zero Libc, Zero Floating Point, Zero Division Premultiplication
// ==========================================

fn bake_trg_payload_len(in_buf, bytes_read) [
    err2 = 0 - 2;
    if (bytes_read < 1) [
        ret err2;
    ]
    err3 = 0 - 3;
    if (bytes_read < 64) [
        ret err3;
    ]
    magic = in_buf@[7 * 1];
    if (magic != TRG_MAGIC_BYTE) [
        ret err3;
    ]
    sa = in_buf@[4 * 1];
    if (sa != 1) [
        ret err3;
    ]
    raw_w0 = in_buf@[0];
    trg_len = raw_w0 & 4294967295;
    if (trg_len < 1) [
        ret err2;
    ]
    need = TRG_PAYLOAD_OFFSET + trg_len;
    if (bytes_read < need) [
        ret err3;
    ]
    ret trg_len;
]

fn bake_premult_ch(c_val, a_val) [
    prod = c_val * a_val;
    x = prod + 128;
    x_hi = x >> 8;
    x_sum = x + x_hi;
    c_premult = x_sum >> 8;
    ret c_premult;
]

fn bake_hex_nibble(ch) [
    if (ch < 6) [
        res_u = ch + 10;
        ret res_u;
    ]
    is_l_lo = ch > 25;
    is_l_hi = ch < 32;
    is_lower = is_l_lo & is_l_hi;
    if (is_lower == 1) [
        res_l = ch - 16;
        ret res_l;
    ]
    is_d_lo = ch > 51;
    is_d_hi = ch < 62;
    is_digit = is_d_lo & is_d_hi;
    if (is_digit == 1) [
        diff = ch - 52;
        ret diff;
    ]
    ret 0;
]

fn bake_skip_ws!(buf, off_ptr, max_bytes) [
    off = off_ptr@[0];
    ws_active = 1;
    loop (ws:100 = 0 .. 100) [
        if (ws_active == 1) [
            in_b = off < max_bytes;
            if (in_b == 0) [
                ws_active = 0;
            ]
            if (ws_active == 1) [
                b = buf@[off * 1];
                is_sp = b == 240;
                is_tb = b == 242;
                is_w = is_sp | is_tb;
                if (is_w == 1) [
                    off = off + 1;
                ]
                if (is_w == 0) [
                    ws_active = 0;
                ]
            ]
        ]
    ]
    off_ptr@[0] = off;
    ret off;
]

fn bake_parse_hex_u32!(buf, off_ptr, max_bytes) [
    off = bake_skip_ws!(buf, off_ptr, max_bytes);
    val = 0;

    if (off < max_bytes) [
        cb = buf@[off * 1];
        if (cb == 127) [
            off = off + 1;
        ]
    ]

    hex_active = 1;
    loop (step:8 = 0 .. 8) [
        if (hex_active == 1) [
            in_b = off < max_bytes;
            if (in_b == 0) [
                hex_active = 0;
            ]
            if (hex_active == 1) [
                ch = buf@[off * 1];
                nib = bake_hex_nibble(ch);
                sh_val = val << 4;
                val = sh_val | nib;
                off = off + 1;
            ]
        ]
    ]

    off_ptr@[0] = off;

    sh_r = val >> 24;
    r = sh_r & 255;
    sh_g = val >> 16;
    g = sh_g & 255;
    sh_b = val >> 8;
    b = sh_b & 255;
    a = val & 255;

    r_p = bake_premult_ch(r, a);
    g_p = bake_premult_ch(g, a);
    b_p = bake_premult_ch(b, a);

    sh_gp = g_p << 8;
    sh_bp = b_p << 16;
    sh_ap = a << 24;
    rg = r_p | sh_gp;
    ba = sh_bp | sh_ap;
    res = rg | ba;
    ret res;
]

fn bake_parse_int!(buf, off_ptr, max_bytes, zero_ch) [
    off = off_ptr@[0];
    val = 0;

    ws_active = 1;
    loop (ws:100 = 0 .. 100) [
        if (ws_active == 1) [
            in_b = off < max_bytes;
            if (in_b == 0) [
                ws_active = 0;
            ]
            if (ws_active == 1) [
                b = buf@[off * 1];
                m_ws = b > 239;
                if (zero_ch == 48) [
                    m_ws = b < 33;
                ]
                if (m_ws == 1) [
                    off = off + 1;
                ]
                if (m_ws == 0) [
                    ws_active = 0;
                ]
            ]
        ]
    ]

    dig_lo = zero_ch - 1;
    dig_hi = zero_ch + 10;
    dig_active = 1;
    loop (dig:16 = 0 .. 16) [
        if (dig_active == 1) [
            in_b = off < max_bytes;
            if (in_b == 0) [
                dig_active = 0;
            ]
            if (dig_active == 1) [
                b = buf@[off * 1];
                is_ge = b > dig_lo;
                is_le = b < dig_hi;
                is_d = is_ge & is_le;
                if (is_d == 1) [
                    d = b - zero_ch;
                    prod = val * 10;
                    val = prod + d;
                    off = off + 1;
                ]
                if (is_d == 0) [
                    dig_active = 0;
                ]
            ]
        ]
    ]

    off_ptr@[0] = off;
    ret val;
]

fn bake_skip_to_nl!(in_buf, off_ptr, max_bytes) [
    off = off_ptr@[0];
    active = 1;
    loop (step:1000 = 0 .. 1000) [
        if (active == 1) [
            in_b = off < max_bytes;
            if (in_b == 0) [
                active = 0;
            ]
            if (active == 1) [
                b = in_buf@[off * 1];
                off = off + 1;
                if (b == 241) [
                    active = 0;
                ]
            ]
        ]
    ]
    off_ptr@[0] = off;
    ret 0;
]

fn bake_parse_style!(in_buf, off_ptr, max_bytes) [
    rgba = bake_parse_hex_u32!(in_buf, off_ptr, max_bytes);

    off2 = off_ptr@[0];
    effect = BAKE_EFFECT_PURE;
    act2 = 1;
    loop (step2:100 = 0 .. 100) [
        if (act2 == 1) [
            in_b = off2 < max_bytes;
            if (in_b == 0) [
                act2 = 0;
            ]
            if (act2 == 1) [
                eb = in_buf@[off2 * 1];
                if (eb == 44) [
                    effect = BAKE_EFFECT_SHUTTER;
                    act2 = 0;
                ]
                if (eb == 241) [
                    act2 = 0;
                ]
                if (act2 == 1) [
                    off2 = off2 + 1;
                ]
            ]
        ]
    ]
    off_ptr@[0] = off2;

    sh_op = 1 << 56;
    sh_eff = effect << 48;
    m_op = sh_op | sh_eff;
    style_w0 = m_op | rgba;
    ret style_w0;
]
