// ==========================================
// sassets/sys/bake_io.sinc
// Sovereign Asset File I/O (Syscall Boundary)
// Zero Libc, Pure SINC Syscall Wrappers
// ==========================================

fn bake_read_file!(in_path, max_bytes, buf_out~, arena) [
    fd_in = sys_open_read!(in_path);
    if (fd_in < 0) [
        ret 0 - 1;
    ]
    w_size = max_bytes >> 3;
    in_buf = arena_alloc_words!(arena, w_size);
    bytes_read = sys_read!(fd_in, in_buf, max_bytes);
    sys_close!(fd_in);
    buf_out@[0] = in_buf;
    ret bytes_read;
]

fn bake_write_sovereign_file!(out_path, magic, w0_lo, payload_buf, payload_words, arena) [
    hdr_buf = arena_alloc_words!(arena, 8);
    w0_mag = magic << 32;
    lo_desc = w0_lo & 4294967295;
    hdr_buf@[0] = w0_mag | lo_desc;

    loop (w:7 = 1 .. 8) [
        hdr_buf@[w] = 0;
    ]

    fd_out = sys_open_write!(out_path);
    if (fd_out < 0) [
        ret 4;
    ]

    sys_write!(fd_out, hdr_buf, 64);
    payload_bytes = payload_words * 8;
    sys_write!(fd_out, payload_buf, payload_bytes);
    sys_close!(fd_out);
    ret 0;
]
