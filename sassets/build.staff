// ==========================================
// sassets/build.staff
// Sovereign Asset Compiler (bin/sagr-bake)
// ==========================================

artifact sassets [
    target = linux_x64;
    type   = bin;
]

deps [
    steel/sys/sys.sinc;
    steel/sys/arena.sinc;
    steel/pure/bitset.sinc;
    sagr/data/surface.sinc;
    sagr/pure/bitops.sinc;
    sagr/pure/flattener.sinc;
    sagr/pure/heddle.sinc;
    sagr/pure/loom.sinc;
    sagr/sys/slsp.sinc;
]

flags [
    optimize = 3;
    heap     = 67108864;
]
